# Local-only configuration: cp .env.example .env && chmod 600 .env
# Shell syntax; sourced by MDX/NICT submitters. Never commit .env or tokens.
# MDX: keep large files and caches on /model or /data, NOT shared /home.

# Paths. Override DATA_HOME for your account; the other paths follow it.
DATA_HOME="/model/${USER}/eval_workspace"
DATA_DIR="${DATA_HOME}/data/eval"
MODEL_ROOT="${DATA_HOME}/models"
EVAL_OUTPUTS="${DATA_HOME}/eval_outputs"
HF_HOME="${DATA_HOME}/cache/huggingface"
UV_CACHE_DIR="${DATA_HOME}/cache/uv"
UV_PYTHON_INSTALL_DIR="${DATA_HOME}/cache/uv-python"

# One Python 3.13.5 / vLLM 0.30.0 environment for LLM-jp, Phi, DSDT and Ray.
# Leave unset to use <checkout>/.venv; use an absolute path on shared storage
# when the environment must be visible from worker nodes.
UV_PROJECT_ENVIRONMENT="${DATA_HOME}/envs/eval/.venv"

# CUDA 13 module shared by ALL three model families on MDX.
EVAL_CUDA_MODULE="cuda/13.0/13.0.3"

# Slurm (LLM-jp MDX guide: at most 16 CPUs and 48 GiB per GPU).
MDX_PARTITION="gpu"
MDX_WALLTIME="20:00:00"
MDX_JOB_PREFIX="0001_eval"
MDX_MEM_PER_GPU_GB=32
# MDX_QOS="gpu-burst"

# LLM-jp Harmony evaluation settings.
LLMJP_REASONING_EFFORT="high"
LLMJP_QUESTION_BATCH_SIZE=4
LLMJP_MAX_MODEL_LEN=65536

# Failure handling.
MAX_TASK_RETRIES=3
RETRY_DELAY_SECONDS=15
LOCK_WAIT_SECONDS=90

# Optional NICT Ray dispatch and official LiveCodeBench code scoring.
RAY_DATA_HOME="${DATA_HOME}"
LCB_ROOT="/path/to/LiveCodeBench"
# LCB_PYTHON="${LCB_ROOT}/.venv/bin/python"
# NICT_CUDA_MODULE="cuda/13.0/13.0.3"

# Credentials (keep only in .env, never source control).
# HF_TOKEN="..."
