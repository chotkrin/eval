# SYNKA configuration. This file is intentionally gitignored.
# Set the actual project ID, your assigned eight H200 nodes, and VERL_HOME.
VERL_HOME="/data/${USER}/verl"
DATA_HOME="${VERL_HOME}"
DATA_DIR="${VERL_HOME}/data/eval"
MODEL_ROOT="${VERL_HOME}/models"
EVAL_OUTPUTS="${VERL_HOME}/eval_outputs"
UV_PROJECT_ENVIRONMENT="${VERL_HOME}/envs/eval/.venv"
HF_HOME="${VERL_HOME}/cache/huggingface"
UV_CACHE_DIR="${VERL_HOME}/cache/uv"
UV_PYTHON_INSTALL_DIR="${VERL_HOME}/cache/uv-python"
TRANSFER_RAW_DIR="${VERL_HOME}/data/raw"

# Change these two values. The node list MUST resolve to exactly 8 nodes
# belonging to SYNKA_PARTITION (no nodes outside this set will be used).
SYNKA_PROJECT_ID="REPLACE_WITH_PROJECT_ID"
SYNKA_PARTITION="${SYNKA_PROJECT_ID}"
SYNKA_NODELIST="REPLACE_WITH_EIGHT_GPU_NODES"
SYNKA_SUBMIT_HOST="cpusv06"
SYNKA_GPU_TYPE="H200"
SYNKA_CUDA_MODULE="cuda/12.8"
# Dedicated partition: 0 requests unlimited; shared ungrouped: use <=24:00:00.
SYNKA_WALLTIME="0"
SYNKA_JOB_PREFIX="eval"
SYNKA_MEM_PER_GPU_GB=32

# Network access required by uv, Hugging Face, and GitHub.
HTTP_PROXY="http://172.22.116.58:8080"
HTTPS_PROXY="${HTTP_PROXY}"
http_proxy="${HTTP_PROXY}"
https_proxy="${HTTPS_PROXY}"

LLMJP_REASONING_EFFORT="high"
LLMJP_QUESTION_BATCH_SIZE=4
LLMJP_MAX_MODEL_LEN=65536
MAX_TASK_RETRIES=3
RETRY_DELAY_SECONDS=15
LOCK_WAIT_SECONDS=90
# Optional secrets: add locally, not in Git.
# HF_TOKEN="..."
